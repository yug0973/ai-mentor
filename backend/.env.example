# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_mentor?schema=public"

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# mentor_ai_engine — the only AI service (interview, roadmap, nudges,
# reviews, feedback). No voice/audio — mentor-brain (TTS) is not used.
ENGINE_BASE_URL=http://localhost:8000

# CORS
CORS_ORIGIN=http://localhost:5173

# Email (SMTP - works with SendGrid, Resend, Gmail, Mailtrap, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_me
SMTP_PASS=replace_me
SMTP_FROM="AI Mentor <no-reply@ai-mentor.app>"

# Web Push (VAPID) - generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=replace_me
VAPID_PRIVATE_KEY=replace_me
VAPID_SUBJECT=mailto:support@ai-mentor.app
